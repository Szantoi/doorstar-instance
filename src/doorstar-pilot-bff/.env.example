# Example names only. Never commit a real DSN, client secret, token or key.
# The runtime BFF accepts only this runtime identity; it deliberately rejects
# bootstrap, generic and all PG* connection variables. This URI must name
# host, port, database, user and password. URI queries/fragments (including
# sslmode) are rejected: the BFF sets TLS verification itself.
DOORSTAR_PILOT_RUNTIME_DATABASE_URL=postgresql://runtime_role:replace-me@127.0.0.1:5432/doorstar_pilot

DOORSTAR_PILOT_PUBLIC_ORIGIN=https://doorstar.example.invalid
DOORSTAR_PILOT_OIDC_REDIRECT_URI=https://doorstar.example.invalid/auth/callback
DOORSTAR_PILOT_SCOPE_KEY=doorstar-pilot
DOORSTAR_PILOT_OIDC_ISSUER=https://identity.example.invalid/realms/doorstar
DOORSTAR_PILOT_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.invalid/realms/doorstar/protocol/openid-connect/auth
DOORSTAR_PILOT_OIDC_TOKEN_ENDPOINT=https://identity.example.invalid/realms/doorstar/protocol/openid-connect/token
DOORSTAR_PILOT_OIDC_JWKS_URL=https://identity.example.invalid/realms/doorstar/protocol/openid-connect/certs
DOORSTAR_PILOT_OIDC_CLIENT_ID=doorstar-pilot-bff
DOORSTAR_PILOT_OIDC_CLIENT_SECRET=replace-through-approved-secret-management
DOORSTAR_PILOT_OIDC_SCOPES=openid,profile,email
DOORSTAR_PILOT_OIDC_ID_TOKEN_ALGORITHMS=RS256

# Separate Keycloak service account used only by the server to create a named
# account disabled, ask Keycloak to send its verification/password-setup
# invitation, and enable/disable that account after local provisioning. It is
# not the browser OIDC client and must receive the narrowest realm-admin
# permission required for those operations. The OIDC token endpoint above must
# be the same issuer realm's standard
# /protocol/openid-connect/token endpoint. Never put a real secret here.
DOORSTAR_PILOT_KEYCLOAK_ADMIN_REALM_BASE_URL=https://identity.example.invalid/admin/realms/doorstar
DOORSTAR_PILOT_KEYCLOAK_ADMIN_CLIENT_ID=doorstar-pilot-roster-admin
DOORSTAR_PILOT_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-through-approved-secret-management

# Exactly 32 random bytes encoded as unpadded base64url (43 characters).
DOORSTAR_PILOT_ENCRYPTION_KEY_BASE64URL=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
DOORSTAR_PILOT_SUBJECT_DIGEST_KEY_BASE64URL=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI

DOORSTAR_PILOT_TRANSACTION_TTL_SECONDS=300
DOORSTAR_PILOT_SESSION_TTL_SECONDS=28800
DOORSTAR_PILOT_BROWSER_BINDING_TTL_SECONDS=86400
DOORSTAR_PILOT_POST_LOGIN_PATH=/
