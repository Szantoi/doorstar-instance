// Üzemi Tábla domain schema.
//
// Vocabulary is deliberately kept close to joinerytech-platform's
// spaceos-modules-production (.NET) module — ProductionJob / WorkflowStep /
// the 6-stage WorkflowStepName enum — so this can be reconciled or merged
// into that module later. See src/production-service/README.md.
//
// Station names (Körfűrész, CNC, Asztalos, ...) are NOT modeled as an enum:
// they are config-driven (config/stations.json) per QUALITY.md ("nincs
// hardcodolt adat"). Task/EpicStep just reference a station by its config key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The 6 macro production stages — mirrors Production.Domain's
/// WorkflowStepName enum (SzabaszatElőgyártás=1 .. KiszállításraMegjelölés=6).
enum Stage {
  SZABASZAT_ELOGYARTAS
  MEGMUNKALAS
  FELULETKEZELES
  OSSZESZERELES
  CSOMAGOLAS
  KISZALLITASRA_MEGJELOLES
}

/// Job-level roll-up status — mirrors Production.Domain's ProductionStatus.
enum ProductionStatus {
  QUEUED
  IN_PROGRESS
  SHIPPING_READY
}

enum SheetKind {
  QUANTITIES
  CUTTING
  HARDWARE
}

enum OrderRevisionStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
}

/// Sales/felmérés readiness is distinct from approval. A revision may be a
/// DRAFT while its field survey is being completed.
enum OrderIntakeStage {
  SALES_DRAFT
  SALES_DOCUMENTS_RECEIVED
  SURVEY_PENDING
  SURVEY_COMPLETED
  SURVEY_EXCEPTION_REVIEW
  TECHNICAL_PREPARATION
}

/// These choices affect the door's manufacturing route and therefore cannot
/// remain free-text once a field survey is finalised.
enum WallTreatment {
  NONE
  WALL_PANEL
  BLENDE
}

enum Glazing {
  NONE
  GLAZED
}

/// A document starts as a reference to the controlled Sales source and can
/// later receive a stable Microsoft Graph identity after SharePoint onboarding.
enum OrderDocumentSource {
  LEGACY_FOLDER
  SHAREPOINT
}

enum OrderDocumentKind {
  SALES_ORDER
  SURVEY
  DRAWING
  OTHER
}

enum SupplementaryItemEntryMode {
  MANUAL
  SOURCE_REVIEW
}

enum SupplementaryItemState {
  REVIEW
  VERIFIED
  REJECTED
}

enum ComponentRequirementKind {
  CUT_PART
  PURCHASED_PART
}

enum ComponentRequirementSourceKind {
  ORDER_POSITION
  MANUFACTURED_ITEM
  SUPPLEMENTARY_ITEM
}

enum ComponentSnapshotState {
  REVIEW
  VERIFIED
  REJECTED
}

enum OperationPlanSnapshotState {
  REVIEW
  VERIFIED
  REJECTED
}

enum OrderRevisionAuditAction {
  REVIEW_REQUESTED
  APPROVED
  SUPERSEDED
}

/// Control-plane lifecycle for the one explicit Kernel tenant associated with
/// a dedicated Doorstar instance. It is deliberately unrelated to the legacy
/// business tables' eventual multi-tenant/RLS migration.
enum DoorstarTenantBindingStatus {
  ACTIVE
  DISABLED
}

/// Narrow capability derived from an exact `joinerytech.door.*` authority
/// grant. It is never a legacy role, station, consumer selector, or token.
enum DoorstarSessionCapability {
  view
  edit
  admin
}

/// A legacy preview is evidence, not an import. Only an explicit, recorded
/// run may later create DRAFT records in the isolated test schema.
enum ImportRunStatus {
  PREVIEWED
  APPLIED
  REJECTED
}

/// Feedback keeps source-data problems visible during the gradual Excel to
/// system transition without mutating the original document or revision.
enum OrderFeedbackCategory {
  DATA_QUALITY
  IMPORT_MAPPING
  DOCUMENT_REFERENCE
  WORKFLOW
}

enum OrderFeedbackStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ImportCandidateStatus {
  READY
  REVIEW
  BLOCKED
  APPLIED
  SKIPPED
}

enum DeadlineObservationKind {
  CONTRACTUAL
  PLANNED_INSTALL
  PRODUCTION_END
  NOTE
}

enum EvidenceReviewState {
  UNVERIFIED
  REVIEW
  RESOLVED
  REJECTED
}

enum OrderPositionEvidenceField {
  CODE
  NAME
  QUANTITY
  PRODUCT_TYPE
  OPENING_DIRECTION
  OPENING_WIDTH_MM
  OPENING_HEIGHT_MM
  OPENING_DEPTH_MM
  DOOR_WIDTH_MM
  DOOR_HEIGHT_MM
  DOOR_THICKNESS_MM
  SURFACE
  WALL_TREATMENT
  GLAZING
  GLAZING_SPECIFICATION
  NOTES
}

enum ManufacturedItemKind {
  WALL_PANEL
  FURNITURE_FRONT
}

enum ManufacturedItemWorkKind {
  STANDARD
  REWORK
  REMANUFACTURE
  REPLACEMENT
}

enum ManufacturedItemState {
  CANDIDATE
  REVIEW
  VERIFIED
  REJECTED
}

enum ManufacturedItemEvidenceField {
  CODE
  NAME
  ITEM_TYPE
  COMPONENT_NAME
  QUANTITY
  WIDTH_MM
  HEIGHT_MM
  THICKNESS_MM
  MATERIAL
  SURFACE
  COLOUR
  PATTERN
  WORK_KIND
  NOTES
}

/// A customer job / megrendelés. Aggregate root, analogous to ProductionJob
/// in the .NET module (OrderId/CustomerId/ProjectName/Deadline/Status there).
model Project {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  num       String?
  kezdes    String?
  beepites  String?
  szinTok   String?
  szinLap   String?
  status    ProductionStatus @default(QUEUED)
  /// Archive timestamp. Archived projects retain their work sheet, issued
  /// tasks and audit history, but no longer appear in active project views.
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  epics  Epic[]
  tasks  Task[]
  sheets ProjectSheet[]
  order  ProductionOrder?

  @@index([deletedAt])
}

/// Doorstar-specific order aggregate attached to the existing Project root.
model ProductionOrder {
  id        String          @id @default(cuid())
  projectId String          @unique
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions OrderRevision[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

/// A revision is immutable once it leaves DRAFT; later changes create a new one.
model OrderRevision {
  id                        String                          @id @default(cuid())
  orderId                   String
  order                     ProductionOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revision                  Int
  status                    OrderRevisionStatus             @default(DRAFT)
  intakeStage               OrderIntakeStage                @default(SALES_DRAFT)
  customerName              String
  customerAddress           String?
  contactName               String?
  contactPhone              String?
  contactEmail              String?
  deliveryAddress           String?
  expectedDelivery          DateTime?
  plannedStart              DateTime?
  priority                  Int                             @default(0)
  notes                     String                          @default("")
  importRunId               String?
  importRun                 ImportRun?                      @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  salesDocumentsReceivedAt  DateTime?
  surveyCompletedAt         DateTime?
  surveyExceptionReason     String?
  positions                 OrderPosition[]
  documents                 OrderDocument[]
  documentReleaseReferences OrderDocumentReleaseReference[]
  audit                     OrderRevisionAudit[]
  feedback                  OrderFeedback[]
  deadlineObservations      OrderDeadlineObservation[]
  manufacturedItems         ManufacturedItem[]
  supplementaryItems        OrderSupplementaryItem[]
  componentSnapshots        ComponentSnapshot[]
  operationPlanSnapshots    OperationPlanSnapshot[]
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  @@unique([orderId, revision])
  @@index([status])
  @@index([intakeStage])
  @@index([importRunId])
}

model OrderFeedback {
  id              String                @id @default(cuid())
  orderRevisionId String
  orderRevision   OrderRevision         @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  category        OrderFeedbackCategory
  status          OrderFeedbackStatus   @default(OPEN)
  message         String
  createdByRole   String
  resolution      String?
  resolvedByRole  String?
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([orderRevisionId, status, createdAt])
}

/// Provenance envelope for a reviewed legacy preview. No production import is
/// possible without one of these records plus a test-schema connection guard.
model ImportRun {
  id                  String          @id @default(cuid())
  /// Stable key for a reviewed bulk preview manifest. Null preserves legacy
  /// one-off runs; non-null is unique so a resumed registration cannot fork.
  registrationKey     String?         @unique
  registrationVersion String?
  artifactFingerprint String?
  reviewNote          String?
  profileVersion      String
  sourceFingerprint   String
  previewArtifact     String
  targetSchema        String
  status              ImportRunStatus @default(PREVIEWED)
  candidateCount      Int             @default(0)
  createdByRole       String
  createdAt           DateTime        @default(now())
  appliedAt           DateTime?

  revisions            OrderRevision[]
  candidates           ImportCandidate[]
  deadlineObservations OrderDeadlineObservation[]

  @@index([status, createdAt])
}

/// Queryable record-level projection of the deterministic preview. It is
/// evidence for an import decision and never an approved production fact.
model ImportCandidate {
  id                String                @id @default(cuid())
  importRunId       String
  importRun         ImportRun             @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  /// Deterministic artifact-hash + row key used by the resumable bulk writer.
  sourceRecordKey   String?
  recordType        String
  workNumber        String?
  sourceRoot        String
  relativePath      String
  sheet             String?
  page              Int?
  row               Int?
  normalizedPayload Json
  errors            String[]              @default([])
  status            ImportCandidateStatus @default(REVIEW)
  createdAt         DateTime              @default(now())
  manufacturedItem  ManufacturedItem?

  @@unique([importRunId, sourceRecordKey])
  @@index([importRunId, status])
  @@index([workNumber])
}

/// Multiple schedule rows may describe one order. Observations preserve all
/// source values without silently replacing the order header deadline.
model OrderDeadlineObservation {
  id              String                  @id @default(cuid())
  importRunId     String
  importRun       ImportRun               @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  orderRevisionId String?
  orderRevision   OrderRevision?          @relation(fields: [orderRevisionId], references: [id], onDelete: SetNull)
  workNumber      String
  sourceRoot      String
  relativePath    String
  sheet           String?
  page            Int?
  row             Int?
  kind            DeadlineObservationKind
  rawValue        String
  normalizedDate  DateTime?
  confidence      Float?
  reviewState     EvidenceReviewState     @default(UNVERIFIED)
  resolution      String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([importRunId, reviewState])
  @@index([orderRevisionId, kind])
  @@index([workNumber])
}

/// Immutable lifecycle evidence for a revision. The approval hash covers the
/// exact position and document-reference snapshot used by downstream work.
model OrderRevisionAudit {
  id                       String                   @id @default(cuid())
  orderRevisionId          String
  orderRevision            OrderRevision            @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  action                   OrderRevisionAuditAction
  actorRole                String
  contentHash              String
  contentHashSchemaVersion Int                      @default(1)
  note                     String                   @default("")
  componentSnapshots       ComponentSnapshot[]
  createdAt                DateTime                 @default(now())

  @@index([orderRevisionId, createdAt])
}

/// Metadata-only document reference. The application stores no local absolute
/// path or binary here; SharePoint/object storage remains the source of truth.
model OrderDocument {
  id                        String                           @id @default(cuid())
  orderRevisionId           String
  orderRevision             OrderRevision                    @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  /// Stable identity shared by all replacements of one logical document.
  documentFamilyKey         String                           @default(cuid())
  supersedesDocumentId      String?                          @unique
  supersedesDocument        OrderDocument?                   @relation("OrderDocumentVersions", fields: [supersedesDocumentId], references: [id])
  nextVersion               OrderDocument?                   @relation("OrderDocumentVersions")
  source                    OrderDocumentSource
  kind                      OrderDocumentKind
  displayName               String
  relativePath              String
  driveId                   String?
  itemId                    String?
  versionId                 String?
  contentSha256             String?
  createdAt                 DateTime                         @default(now())
  positionEvidence          OrderPositionEvidence[]
  manufacturedItemEvidence  ManufacturedItemEvidence[]
  supplementaryItemEvidence OrderSupplementaryItemEvidence[]
  positionLinks             OrderDocumentPositionLink[]
  releaseReferences         OrderDocumentReleaseReference[]

  @@index([orderRevisionId])
  @@index([orderRevisionId, documentFamilyKey])
  @@index([source, kind])
}

/// Direct technical-document membership of an order position, separate from
/// field-level evidence which explains a single captured value.
model OrderDocumentPositionLink {
  id              String        @id @default(cuid())
  orderDocumentId String
  orderDocument   OrderDocument @relation(fields: [orderDocumentId], references: [id], onDelete: Cascade)
  orderPositionId String
  orderPosition   OrderPosition @relation(fields: [orderPositionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([orderDocumentId, orderPositionId])
  @@index([orderPositionId])
}

/// Immutable document-version snapshot issued to a future or external work
/// package. The work-package aggregate will later own `issuedWorkPackageKey`.
model OrderDocumentReleaseReference {
  id                    String        @id @default(cuid())
  orderRevisionId       String
  orderRevision         OrderRevision @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  orderDocumentId       String
  orderDocument         OrderDocument @relation(fields: [orderDocumentId], references: [id], onDelete: Restrict)
  issuedWorkPackageKey  String
  documentVersionId     String?
  documentContentSha256 String
  releasedByRole        String
  releaseNote           String
  createdAt             DateTime      @default(now())

  @@unique([issuedWorkPackageKey, orderDocumentId])
  @@index([orderRevisionId, issuedWorkPackageKey])
}

/// One Doorstar door/product position captured before calculation.
model OrderPosition {
  id                       String                      @id @default(cuid())
  orderRevisionId          String
  orderRevision            OrderRevision               @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  position                 Int
  code                     String
  name                     String
  quantity                 Int
  productType              String?
  openingDirection         String?
  openingWidthMm           Float?
  openingHeightMm          Float?
  openingDepthMm           Float?
  doorWidthMm              Float?
  doorHeightMm             Float?
  doorThicknessMm          Float?
  surface                  String?
  wallTreatment            WallTreatment?
  glazing                  Glazing?
  glazingSpecification     String?
  doorTypeKey              String?
  finishKey                String?
  glassKey                 String?
  hardwareKeys             String[]                    @default([])
  wallSolutionKey          String?
  materialKey              String?
  machiningKeys            String[]                    @default([])
  technicalNotes           String                      @default("")
  notes                    String                      @default("")
  evidence                 OrderPositionEvidence[]
  documentLinks            OrderDocumentPositionLink[]
  relatedManufacturedItems ManufacturedItem[]

  @@unique([orderRevisionId, position])
}

/// Field-level provenance for one position. Evidence explains a value but
/// never mutates the position automatically.
model OrderPositionEvidence {
  id                  String                     @id @default(cuid())
  orderPositionId     String
  orderPosition       OrderPosition              @relation(fields: [orderPositionId], references: [id], onDelete: Cascade)
  orderDocumentId     String?
  orderDocument       OrderDocument?             @relation(fields: [orderDocumentId], references: [id], onDelete: SetNull)
  sourceRoot          String
  relativePath        String
  sheet               String?
  page                Int?
  row                 Int?
  field               OrderPositionEvidenceField
  rawValue            String
  normalizedValue     Json
  confidence          Float?
  reviewState         EvidenceReviewState        @default(UNVERIFIED)
  resolution          String?
  createdByRole       String
  /// Declared request principal captured by the final review command. This is
  /// audit data; authentication of the principal remains a separate boundary.
  reviewedByPrincipal String?
  reviewedByRole      String?
  reviewedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([orderPositionId, field, reviewState])
  @@index([orderDocumentId])
}

/// Sales extras are neither door positions nor standalone manufactured items.
/// Manual entries and source-reviewed import entries share this one lane.
model OrderSupplementaryItem {
  id                 String                           @id @default(cuid())
  orderRevisionId    String
  orderRevision      OrderRevision                    @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  entryMode          SupplementaryItemEntryMode
  state              SupplementaryItemState           @default(REVIEW)
  category           String
  code               String?
  name               String
  quantity           Float?
  unit               String?
  calculatedQuantity Float?
  calculatedUnit     String?
  notes              String                           @default("")
  manualReason       String?
  createdByRole      String
  reviewedByRole     String?
  reviewedAt         DateTime?
  reviewResolution   String?
  evidence           OrderSupplementaryItemEvidence[]
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@index([orderRevisionId, state])
}

model OrderSupplementaryItemEvidence {
  id                  String                 @id @default(cuid())
  supplementaryItemId String
  supplementaryItem   OrderSupplementaryItem @relation(fields: [supplementaryItemId], references: [id], onDelete: Cascade)
  orderDocumentId     String?
  orderDocument       OrderDocument?         @relation(fields: [orderDocumentId], references: [id], onDelete: SetNull)
  sourceRoot          String
  relativePath        String
  page                Int?
  row                 Int?
  field               String
  rawValue            String
  normalizedValue     Json
  confidence          Float?
  reviewState         EvidenceReviewState    @default(UNVERIFIED)
  resolution          String?
  createdByRole       String
  reviewedByRole      String?
  reviewedAt          DateTime?
  createdAt           DateTime               @default(now())

  @@index([supplementaryItemId, field, reviewState])
  @@index([orderDocumentId])
}

/// A standalone wall panel or furniture front. It belongs to the approved
/// order snapshot without borrowing door-only semantics.
model ManufacturedItem {
  id                     String                     @id @default(cuid())
  orderRevisionId        String
  orderRevision          OrderRevision              @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  relatedOrderPositionId String?
  relatedOrderPosition   OrderPosition?             @relation(fields: [relatedOrderPositionId], references: [id], onDelete: SetNull)
  importCandidateId      String?                    @unique
  importCandidate        ImportCandidate?           @relation(fields: [importCandidateId], references: [id], onDelete: SetNull)
  kind                   ManufacturedItemKind
  code                   String
  name                   String
  itemType               String?
  componentName          String?
  quantity               Int
  widthMm                Float?
  heightMm               Float?
  thicknessMm            Float?
  material               String?
  surface                String?
  colour                 String?
  pattern                String?
  workKind               ManufacturedItemWorkKind   @default(STANDARD)
  state                  ManufacturedItemState      @default(CANDIDATE)
  notes                  String                     @default("")
  resolution             String?
  reviewedByRole         String?
  reviewedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  evidence               ManufacturedItemEvidence[]

  @@unique([orderRevisionId, kind, code])
  @@index([orderRevisionId, kind, state])
  @@index([relatedOrderPositionId])
}

/// Field-level source evidence for a standalone panel or front. It explains
/// candidate values and never creates production tasks by itself.
model ManufacturedItemEvidence {
  id                 String                        @id @default(cuid())
  manufacturedItemId String
  manufacturedItem   ManufacturedItem              @relation(fields: [manufacturedItemId], references: [id], onDelete: Cascade)
  orderDocumentId    String?
  orderDocument      OrderDocument?                @relation(fields: [orderDocumentId], references: [id], onDelete: SetNull)
  sourceRoot         String
  relativePath       String
  sheet              String?
  page               Int?
  row                Int?
  field              ManufacturedItemEvidenceField
  rawValue           String
  normalizedValue    Json
  confidence         Float?
  reviewState        EvidenceReviewState           @default(UNVERIFIED)
  resolution         String?
  createdByRole      String
  reviewedByRole     String?
  reviewedAt         DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([manufacturedItemId, field, reviewState])
  @@index([orderDocumentId])
}

/// Immutable output of one configured calculator adapter for one approved
/// order revision. A profile version may produce exactly one payload.
model ComponentSnapshot {
  id                           String                  @id @default(cuid())
  orderRevisionId              String
  orderRevision                OrderRevision           @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  approvalAuditId              String
  approvalAudit                OrderRevisionAudit      @relation(fields: [approvalAuditId], references: [id], onDelete: Restrict)
  state                        ComponentSnapshotState  @default(REVIEW)
  snapshotSchemaVersion        String
  calculatorProfileVersion     String
  calculatorProfileFingerprint String
  technicalCatalogVersion      String
  technicalCatalogFingerprint  String
  sourceWorkOrderKey           String
  sourceOrderRevision          String
  sourceCalculatorRevision     String
  orderContentHash             String
  inputHash                    String
  outputHash                   String
  materializationKey           String                  @unique
  reviewNote                   String
  createdByRole                String
  reviewResolution             String?
  reviewedByRole               String?
  reviewedAt                   DateTime?
  requirements                 ComponentRequirement[]
  operationPlanSnapshots       OperationPlanSnapshot[]
  createdAt                    DateTime                @default(now())

  @@unique([orderRevisionId, calculatorProfileVersion])
  @@index([orderRevisionId, createdAt])
}

/// A single calculator-produced requirement with explicit source lineage.
/// CUT_PART dimensions are adapter output; this model never derives them.
model ComponentRequirement {
  id                  String                         @id @default(cuid())
  componentSnapshotId String
  componentSnapshot   ComponentSnapshot              @relation(fields: [componentSnapshotId], references: [id], onDelete: Cascade)
  sourceKind          ComponentRequirementSourceKind
  sourceRecordId      String
  requirementKind     ComponentRequirementKind
  sourceComponentKey  String
  componentKey        String
  name                String
  quantity            Float
  quantityUnit        String
  materialKey         String?
  finishKey           String?
  finishedWidthMm     Float?
  finishedHeightMm    Float?
  finishedThicknessMm Float?
  cuttingWidthMm      Float?
  cuttingHeightMm     Float?
  cuttingThicknessMm  Float?
  grainDirection      String?
  lineHash            String
  notes               String                         @default("")
  createdAt           DateTime                       @default(now())

  @@unique([componentSnapshotId, sourceComponentKey])
  @@index([sourceKind, sourceRecordId])
}

/// Immutable, exact-revision plan candidate set. It is a reviewed planning
/// input only: it cannot issue work packages or mutate runtime production.
model OperationPlanSnapshot {
  id                          String                     @id @default(cuid())
  orderRevisionId             String
  orderRevision               OrderRevision              @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  componentSnapshotId         String
  componentSnapshot           ComponentSnapshot          @relation(fields: [componentSnapshotId], references: [id], onDelete: Restrict)
  state                       OperationPlanSnapshotState @default(REVIEW)
  schemaVersion               String
  generatorProfileVersion     String
  generatorProfileFingerprint String
  standardCatalogVersion      String
  standardCatalogFingerprint  String
  resourceMappingVersion      String
  resourceMappingFingerprint  String
  orderContentHash            String
  componentOutputHash         String
  inputHash                   String
  outputHash                  String
  materializationKey          String                     @unique
  reviewNote                  String
  createdByRole               String
  createdByPrincipal          String
  reviewResolution            String?
  reviewedByRole              String?
  reviewedByPrincipal         String?
  reviewedAt                  DateTime?
  operations                  Json
  createdAt                   DateTime                   @default(now())

  @@unique([componentSnapshotId, generatorProfileVersion])
  @@index([orderRevisionId, createdAt])
  @@index([componentSnapshotId, createdAt])
}

/// One manufactured component within a project's work-order sheet
/// (e.g. "Tok 22-es", "Ajtólap 5-ös") — a row group on the munkalap.
model Epic {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  quantityLabel String?
  position      Int     @default(0)
  disabled      Boolean @default(false)

  steps EpicStep[]
  /// Free-standing board tasks can belong directly to an epic without
  /// pretending to be one of the work-sheet's manufacturing steps.
  tasks Task[]

  @@index([projectId])
}

/// A single manufacturing step of an Epic (e.g. "Marás" at station "CNC").
/// Analogous to Production.Domain's WorkflowStep, but per-component and
/// per-station rather than one of the fixed 6 macro stages — `stage` derives
/// the macro stage via config/stations.json's station→stage mapping.
model EpicStep {
  id         String    @id @default(cuid())
  epicId     String
  epic       Epic      @relation(fields: [epicId], references: [id], onDelete: Cascade)
  name       String
  station    String?
  quantity   Float?
  unitHours  Float?
  planDate   DateTime?
  planLocked Boolean   @default(false)
  disabled   Boolean   @default(false)
  position   Int       @default(0)

  tasks Task[]

  @@index([epicId])
}

/// A physical card on the board: either a scheduled EpicStep instance
/// (placed on a specific week/day, dependency-ordered) or a free-standing
/// task typed straight onto the board / kanban ("Szabad feladat").
model Task {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  epicId       String?
  epic         Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)
  epicStepId   String?
  epicStep     EpicStep? @relation(fields: [epicStepId], references: [id])
  epicName     String?
  title        String
  station      String?
  week         String
  day          Int
  stepIndex    Int       @default(0)
  acknowledged Boolean   @default(false)
  urgent       Boolean   @default(false)
  problem      Boolean   @default(false)
  dueDate      String?
  description  String    @default("")
  /// Task-level snapshot/override used for board-created work and capacity.
  /// Issued cards start from their EpicStep values but may be adjusted later.
  quantity     Float?
  unitHours    Float?
  dependsOnId  String?   @unique
  dependsOn    Task?     @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependent    Task?     @relation("TaskDependency")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments TaskComment[]
  images   TaskImage[]
  audit    TaskAuditEntry[]

  @@index([week, day])
  @@index([station])
  @@index([projectId])
  @@index([epicId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model TaskImage {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model TaskAuditEntry {
  id     String   @id @default(cuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label  String
  at     DateTime @default(now())
}

/// Per-station kanban workflow (ordered step names), e.g. Bürkle:
/// ["Felvett","Élzárás","Lécezés","Kész"]. Falls back to the config default
/// (["Felvett","Folyamatban","Kész"]) when no row exists for a station.
model StationWorkflow {
  station String @id
  steps   Json
}

/// Free-standing checklist shown in the board sidebar ("Lista").
model OrderChecklistItem {
  id       String  @id @default(cuid())
  label    String
  done     Boolean @default(false)
  position Int     @default(0)
}

/// Weekly free-text notes ("Infó" row on the board), keyed by ISO Monday date.
model WeekNote {
  week String @id
  text String @default("")
}

/// Reusable full work-order-sheet template (a whole set of epics/steps),
/// e.g. "Ajtó (alap)".
model SheetTemplate {
  id    String @id @default(cuid())
  name  String @unique
  epics Json
}

/// Reusable single-epic template, addable into any project's sheet.
model EpikTemplate {
  id   String @id @default(cuid())
  name String @unique
  epic Json
}

/// Global capacity assumption used by the load monitor (hours/day/station).
model CapacitySetting {
  id          String @id @default("default")
  hoursPerDay Float  @default(8)
}

/// Free-form sub-sheets of a project's munkalap that vary heavily by product
/// type (quantities breakdown, cutting list, door/furniture hardware specs).
/// Kept as JSON rather than normalized — see README "Design decisions".
model ProjectSheet {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      SheetKind
  data      Json
  updatedAt DateTime  @updatedAt

  @@unique([projectId, kind])
}

/// Instance-level trial binding. Raw SQL in the forward-only migration enforces
/// the lifetime singleton and the sole ACTIVE -> DISABLED transition; Prisma
/// model metadata alone is not the authority for that lifecycle.
model DoorstarInstanceTenantBinding {
  id              String                      @id @default(cuid())
  tenantId        String                      @db.Uuid
  status          DoorstarTenantBindingStatus @default(ACTIVE)
  bindingVersion  BigInt                      @default(1)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  disabledAt      DateTime?                   @db.Timestamptz(6)
  disabledReason  String?
  evidences       IdentityAuthorityEvidence[] @relation("DoorstarEvidenceBinding")
  sessions        DoorstarSession[]           @relation("DoorstarSessionBinding")

  /// Supports the evidence-side composite FK, which proves its tenant snapshot
  /// belongs to this exact binding row instead of merely to any binding id.
  @@unique([id, tenantId])
}

/// Immutable, token-free record of an accepted M0 authority resolution. The
/// migration blocks UPDATE/DELETE and persists exact UTC triples because a
/// DateTime value alone cannot carry the required nanosecond proof/cutoff.
model IdentityAuthorityEvidence {
  id                                         String                           @id @default(cuid())
  tenantBindingId                            String
  tenantId                                   String                           @db.Uuid
  bindingVersion                             BigInt
  subject                                    String
  schemaVersion                              String
  membershipVersion                          BigInt
  projectionVersion                          BigInt
  enabledModules                             Json
  permissions                                Json
  acceptTokensIssuedAtOrAfterWire            String
  acceptTokensIssuedAtOrAfterEpochSeconds    BigInt
  acceptTokensIssuedAtOrAfterNanoseconds     Int
  tokenIssuedAtWire                          String
  tokenIssuedAtEpochSeconds                  BigInt
  tokenIssuedAtNanoseconds                   Int
  tokenExpiresAtWire                         String
  tokenExpiresAtEpochSeconds                 BigInt
  tokenExpiresAtNanoseconds                  Int
  stateMacKeyVersion                         Int
  stateMac                                   Bytes
  correlationId                              String                           @db.Uuid
  evidenceVersion                            Int                              @default(1)
  createdAt                                  DateTime                         @default(now()) @db.Timestamptz(6)
  tenantBinding                              DoorstarInstanceTenantBinding   @relation("DoorstarEvidenceBinding", fields: [tenantBindingId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  sessions                                   DoorstarSession[]                @relation("DoorstarSessionEvidence")

  /// Required reference target for the session's exact binding/evidence FK.
  @@unique([id, tenantBindingId])
  @@index([tenantBindingId, subject, createdAt])
}

/// Opaque M2 session state. Only HMACs of verifier/CSRF/state material are
/// persisted; no human bearer, refresh token, M2M assertion, role, station,
/// consumer id, or authorization code has a column in this model.
model DoorstarSession {
  id                      String                         @id @default(cuid())
  sessionSelector         String                         @unique
  verifierMacKeyVersion   Int
  verifierMac             Bytes
  csrfMacKeyVersion       Int
  csrfMac                 Bytes
  stateMacKeyVersion      Int
  stateMac                Bytes
  tenantBindingId         String
  evidenceId              String
  subject                 String
  capability              DoorstarSessionCapability
  bindingVersion          BigInt
  issuedAtWire            String
  issuedAtEpochSeconds    BigInt
  issuedAtNanoseconds     Int
  expiresAtWire           String
  expiresAtEpochSeconds   BigInt
  expiresAtNanoseconds    Int
  revokedAt               DateTime?                     @db.Timestamptz(6)
  revokeReason            String?
  lastValidatedAt         DateTime?                     @db.Timestamptz(6)
  createdAt               DateTime                       @default(now()) @db.Timestamptz(6)
  tenantBinding           DoorstarInstanceTenantBinding @relation("DoorstarSessionBinding", fields: [tenantBindingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evidence                IdentityAuthorityEvidence     @relation("DoorstarSessionEvidence", fields: [evidenceId, tenantBindingId], references: [id, tenantBindingId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([verifierMacKeyVersion, verifierMac])
  @@unique([csrfMacKeyVersion, csrfMac])
  @@index([tenantBindingId, revokedAt, expiresAtEpochSeconds, expiresAtNanoseconds])
}
