PORT=4610
DATABASE_URL="postgresql://doorstar:doorstar@localhost:5462/doorstar_production?schema=public"
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4611
# Flow Lab file-handoff import. This server-side directory is never accepted
# from an HTTP caller; it must contain an already-validated final artifact
# plus its matching SHA-256 sidecar.
FLOW_LAB_PLAN_INBOX_DIR=
# Optional. When all four are present the future Graph connector becomes read-only.
# The deployment identity supplies the access token; do not add a client secret here.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
