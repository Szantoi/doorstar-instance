{
  "name": "@doorstar/pilot-staging-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Disposable, source-verified A-03 two-scope proof harness. It is not part of the Doorstar runtime.",
  "type": "module",
  "files": [
    "README.md",
    "scripts/gate1ExternalTrustAnchorRequired.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:gate0": "node --test ../../scripts/doorstar-pilot-gate0/test/gate0.test.mjs",
    "test:gate1": "node --test ../../scripts/doorstar-pilot-gate1/test/gate1.test.mjs",
    "verify:fixture": "tsx scripts/verifyTwoScopeFixture.ts",
    "verify:boundary": "tsx scripts/verifyHarnessBoundary.ts",
    "test": "npm run verify:fixture && npm run verify:boundary && npm run test:gate0 && npm run test:gate1 && npm run test:unit",
    "proof:docker": "node scripts/gate1ExternalTrustAnchorRequired.mjs"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@types/pg": "8.11.10",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
