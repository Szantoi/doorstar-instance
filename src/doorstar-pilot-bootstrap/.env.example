# Source-only example. Keep the real bootstrap DSN in the approved secret
# store/environment; never commit it or place it in a BFF runtime configuration.
PILOT_BOOTSTRAP_DATABASE_URL=<provided-by-approved-secret-store>

# Fixed server configuration. It is resolved transactionally to a scope UUID;
# it is not a CLI argument and cannot be chosen by an operator at invocation.
DOORSTAR_PILOT_SCOPE_KEY=doorstar-pilot

# Intentionally absent: DOORSTAR_PILOT_RUNTIME_DATABASE_URL, DATABASE_URL,
# OIDC client secrets, raw OIDC subjects, browser tokens and passwords.
