# Federation messages (file-based, not Git)
**/terminals/*/inbox/
**/terminals/*/outbox/
**/terminals/*/archive/

# Build & runtime
node_modules/
dist/
logs/
*.log
*.log.err
*.tsbuildinfo

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
.mcp-token*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/


# SQLite runtime files
*.db-shm
*.db-wal

# Island runtime state (migrated DBs, caches) — never on git
data/

# Local QA and generated import artefacts
.playwright-mcp/
tmp/
**/__pycache__/
*.py[cod]
src/production-service/IMPORT_PREVIEW_*.json
