{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doorstar.local/schemas/doorstar-faipari-terminology.schema.json",
  "title": "Doorstar faipari terminológiai részhalmaz",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaFile",
    "schemaVersion",
    "version",
    "publishedAt",
    "language",
    "scope",
    "authoritativeMarkdown",
    "evidencePolicy",
    "lookupPolicy",
    "dimensionOrder",
    "unit",
    "classifications",
    "automationPolicies",
    "terms"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "./doorstar-faipari-terminology.schema.json" },
    "schemaFile": { "type": "string", "const": "doorstar-faipari-terminology.schema.json" },
    "schemaVersion": { "type": "string", "const": "doorstar-terminology/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publishedAt": { "type": "string", "format": "date" },
    "language": { "type": "string", "const": "hu-HU" },
    "scope": { "type": "string", "minLength": 1 },
    "authoritativeMarkdown": { "type": "string", "pattern": "^[^/\\\\]+\\.md$" },
    "evidencePolicy": { "type": "string", "minLength": 1 },
    "lookupPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceTermMatching", "codeTermMatching", "collisionPolicy", "targetPolicy"],
      "properties": {
        "version": { "type": "string", "const": "doorstar-terminology-lookup/v1" },
        "sourceTermMatching": { "type": "string", "minLength": 1 },
        "codeTermMatching": { "type": "string", "minLength": 1 },
        "collisionPolicy": { "type": "string", "minLength": 1 },
        "targetPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "dimensionOrder": {
      "type": "array",
      "prefixItems": [
        { "const": "WIDTH" },
        { "const": "HEIGHT" },
        { "const": "THICKNESS_OR_DEPTH" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "unit": { "type": "string", "const": "mm" },
    "classifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/classification" },
      "uniqueItems": true
    },
    "automationPolicies": {
      "type": "array",
      "items": { "$ref": "#/$defs/automationPolicy" },
      "uniqueItems": true
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term" }
    }
  },
  "$defs": {
    "classification": {
      "type": "string",
      "enum": ["CANONICAL", "DOORSTAR_LOCAL", "SYSTEM_TERM", "REVIEW", "DEPRECATED"]
    },
    "automationPolicy": {
      "type": "string",
      "enum": ["ALLOW", "ALIAS_ONLY", "REVIEW_REQUIRED", "FORBIDDEN"]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "canonicalHu",
        "english",
        "sourceTerms",
        "codeTerms",
        "classification",
        "automationPolicy",
        "definition",
        "mustNotMean"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": {
          "type": "string",
          "enum": ["APPEARANCE", "BUSINESS", "DATE", "DOCUMENT", "GEOMETRY", "IDENTIFIER", "LEGACY_CODE", "PROCESS", "PRODUCT", "STAGE", "STATUS", "SYSTEM"]
        },
        "canonicalHu": { "type": "string", "minLength": 1 },
        "english": { "type": ["string", "null"] },
        "sourceTerms": { "$ref": "#/$defs/stringArray" },
        "deprecatedSourceTerms": { "$ref": "#/$defs/stringArray" },
        "codeTerms": { "$ref": "#/$defs/stringArray" },
        "legacyCodeTerms": { "$ref": "#/$defs/stringArray" },
        "targetCodeTerms": { "$ref": "#/$defs/stringArray" },
        "relatedCodeTerms": { "$ref": "#/$defs/stringArray" },
        "authorityStatus": { "type": "string", "enum": ["LEGACY_AMBIGUOUS"] },
        "classification": { "$ref": "#/$defs/classification" },
        "automationPolicy": { "$ref": "#/$defs/automationPolicy" },
        "definition": { "type": "string", "minLength": 1 },
        "mustNotMean": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
