# Copy only to /etc/doorstar/doorstar-flow-lab-demo.env on the VPS.
# Substitute the generated database password there; never commit it.
PORT=4612
HOST=127.0.0.1
DATABASE_URL="postgresql://doorstar_flow_lab_demo_app:<generated-password>@127.0.0.1:5462/doorstar_production?schema=doorstar_flow_lab_demo"
LOG_LEVEL=info
CORS_ORIGIN=https://doorstar.asztalostech.hu,https://doorstar.joinerytech.hu
