# Replace every __PILOT_*__ value during the separately approved release.
# This vhost owns only the new isolated Doorstar pilot. Do not merge it with
# historical Doorstar Board, SpaceOS, or Plant sites.

server {
    listen 80;
    listen [::]:80;
    server_name __PILOT_PUBLIC_HOST__;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __PILOT_PUBLIC_HOST__;

    ssl_certificate __PILOT_TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __PILOT_TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:doorstar_pilot_tls:10m;

    client_max_body_size 16k;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:__PILOT_LOOPBACK_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
    }
}
